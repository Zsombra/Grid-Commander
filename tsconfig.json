{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    // Added by `next build`. Kept here so the build does not rewrite this file.
    "allowJs": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `.next` must NOT be excluded: exclude filters include, so excluding it
  // silently discards the `.next/types` route checks named one line up — the
  // build gate then reports on a check it throws away (#216). The guard in
  // tests/architecture/tsconfig-coherence.test.ts enforces this.
  "exclude": ["node_modules"]
}
