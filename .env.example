# Registered out of band, once per environment, and pinned here.
# Registration is open and unauthenticated, so a client_id obtained at runtime
# would be unverifiable. Register with scope "mcp:read" only — wager authority
# is then unrequestable rather than merely unrequested.
BATTLEGRID_CLIENT_ID=

# Must exactly match a redirect_uri on the registration. No wildcards.
BATTLEGRID_REDIRECT_URI=http://localhost:3000/api/auth/battlegrid/callback

DATABASE_URL=postgres://localhost:5432/grid_commander

# 32 random bytes, base64. Tokens are encrypted at rest with this; a database
# dump alone must not be enough to use someone's BattleGrid account.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
