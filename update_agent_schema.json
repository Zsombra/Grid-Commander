              "includeHigherTimeframe": {
                "type": "boolean"
              },
              "includeRegimeContext": {
                "type": "boolean"
              },
              "includeStructureZones": {
                "type": "boolean"
              },
              "includeCrowdIntelligence": {
                "type": "boolean"
              },
              "includeCvd": {
                "type": "boolean"
              },
              "includeCvdCrowdConvergence": {
                "type": "boolean"
              },
              "includeMtfConfluence": {
                "type": "boolean"
              },
              "includePerpSpotFlow": {
                "type": "boolean"
              },
              "includeMarketBreadth": {
                "type": "boolean"
              },
              "includeReferencePairs": {
                "type": "boolean"
              }
            },
            "required": [
              "includePriceAction",
              "includeSubTimeframe",
              "includeRsi",
              "includeMacd",
              "includeVolume",
              "includeVolatility",
              "includeBollingerBands",
              "includeMovingAverages",
              "includeStochastic",
              "includeFundingRates",
              "includeOpenInterest",
              "includeRelativeStrength",
              "includeSupportResistance",
              "includeTrendStrength",
              "includeMfi",
